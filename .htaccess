# Only the current site's pages are routable. Disable implicit file matching
# and directory listings so leftover files cannot bring retired pages back.
<If "%{HTTP_HOST} =~ m#^(?:www\.)?setupshoponline\.com(?::[0-9]+)?$#">
  Options -MultiViews -Indexes
  ErrorDocument 404 /page-unavailable.html
  ErrorDocument 410 /page-unavailable.html
</If>

RewriteEngine On
# This public_html directory also contains a separate assistant subdomain.
# Apply the marketing-site route policy only to its own hostname.
RewriteCond %{HTTP_HOST} !^(?:www\.)?setupshoponline\.com(?::[0-9]+)?$ [NC]
RewriteRule ^ - [L]

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Canonical host: redirect non-www to apex (already apex; redirect www -> apex)
RewriteCond %{HTTP_HOST} ^www\.setupshoponline\.com$ [NC]
RewriteRule ^(.*)$ https://setupshoponline.com/$1 [L,R=301]

# Workbook API is handled by PHP; backend/data stay outside public_html.
RewriteRule ^api/workbook/(?:config|subscribe|session|access|download|connect|outlook-callback|connected)$ api/workbook/index.php [END]
RewriteRule ^api/workbook/index\.php$ - [END]
RewriteRule ^server(?:/|$) - [F,L]

# Retired pages have no replacement. Return 410 even if old files/directories
# remain in public_html. Cover descendants, case variants and old extensions.
RewriteRule ^(?:case-studies|ai-growth-strategy|ai-search-optimization|services|web-design|seo|search-engine-optimization|hosting|blog)(?:\.(?:html?|php))?(?:/.*)?$ - [G,NC]

# Keep genuine renamed-page links working.
RewriteRule ^(?:about|about-us)(?:\.html?)?/?$ /why-setupshoponline [R=301,L,NC]
RewriteRule ^contact(?:\.html?)?/?$ /contact-us [R=301,L,NC]
RewriteRule ^(?:book|booking)(?:\.html?)?/?$ /book-a-call [R=301,L,NC]

# Canonicalize current page URLs, without redirecting internal HTML rewrites.
RewriteCond %{THE_REQUEST} \s/+index\.html[?\s] [NC]
RewriteRule ^index\.html$ / [R=301,L]
RewriteCond %{THE_REQUEST} \s/+[^?\s]+\.html[?\s] [NC]
RewriteRule ^(why-setupshoponline|contact-us|book-a-call|privacy|terms|free-workbook|workbook-access|thank-you/workbook|thank-you/booking|thank-you/contact)\.html$ /$1 [R=301,L]
RewriteRule ^(why-setupshoponline|contact-us|book-a-call|privacy|terms|free-workbook|workbook-access|thank-you/workbook|thank-you/booking|thank-you/contact)/+$ /$1 [R=301,L]

# Explicit current-page list. Do not restore the catch-all SPA fallback.
RewriteRule ^$ index.html [END]
RewriteRule ^(why-setupshoponline|contact-us|book-a-call|privacy|terms|free-workbook|workbook-access|thank-you/workbook|thank-you/booking|thank-you/contact)$ $1.html [END]
RewriteRule ^(?:index|why-setupshoponline|contact-us|book-a-call|privacy|terms|free-workbook|workbook-access|thank-you/workbook|thank-you/booking|thank-you/contact|page-unavailable)\.html$ - [END]

# Allow certificate challenges and existing search ownership verification files.
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^(?:\.well-known/.*|google[a-zA-Z0-9]+\.html|BingSiteAuth\.xml)$ - [END]

# Keep real static resources working. HTML, scripts on the server, extensionless
# legacy files and directory index pages are intentionally not allowed here.
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule \.(?:css|js|mjs|json|png|jpe?g|gif|webp|avif|svg|ico|woff2?|ttf|eot|pdf|txt|xml|webmanifest|mp4|webm|mp3|ogg)$ - [END,NC]

# Unknown URLs must be real 404s, including leftover HTML/PHP files on the host.
RewriteRule ^ - [R=404,L]

# Gzip compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# Cache static assets aggressively (hashed filenames)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Don't cache index.html (so deploys are picked up immediately)
<FilesMatch "index\.html$">
  Header set Cache-Control "no-cache, no-store, must-revalidate"
  Header set Pragma "no-cache"
  Header set Expires "0"
</FilesMatch>

# humans.txt, llms.txt, robots.txt, sitemap.xml as text
<FilesMatch "\.(txt|xml)$">
  Header set Cache-Control "public, max-age=3600"
</FilesMatch>

# ---------------------------------------------------------------------------
# Security headers
# Applied to all responses. Tightened for a public, frontend-only marketing
# site that uses Calendly, Zoho Bigin, Google Maps, and Google Fonts.
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
  # Force HTTPS for one year (no preload until all subdomains verified).
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Prevent MIME sniffing.
  Header always set X-Content-Type-Options "nosniff"

  # Send origin only on cross-origin and never downgrade to HTTP.
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Disable powerful APIs the site does not use, plus FLoC.
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"

  # Legacy clickjacking protection. CSP frame-ancestors below is authoritative
  # for modern browsers.
  Header always set X-Frame-Options "SAMEORIGIN"

  # Content Security Policy
  # default-src locked to self.
  # script-src allows Calendly widget loader and inline JSON-LD blocks
  # (react-helmet-async injects schema as inline <script type=ld+json>).
  # style-src allows Google Fonts and inline styles used by Calendly/Tailwind.
  # img-src is broad (https:) so social previews, partner logos, and Bigin QR
  # codes load without per-domain whitelisting.
  # frame-src whitelists Calendly, Zoho Bigin, and Google Maps embeds only.
  # connect-src allows Calendly's API + analytics calls.
  # form-action keeps native form posts on same origin (Bigin form posts inside
  # the iframe and is therefore not constrained by the parent's form-action).
  # frame-ancestors 'self' replaces X-Frame-Options on modern browsers.
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self' 'unsafe-inline' https://assets.calendly.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://assets.calendly.com; font-src 'self' https://fonts.gstatic.com https://assets.calendly.com data:; img-src 'self' data: blob: https:; frame-src 'self' https://calendly.com https://*.calendly.com https://us.bigin.online https://bigin.zoho.com https://www.google.com https://maps.google.com; connect-src 'self' https://calendly.com https://*.calendly.com; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
</IfModule>
